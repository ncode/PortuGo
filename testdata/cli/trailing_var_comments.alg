algoritmo "comments"
// procedure documentation
procedimento P()
inicio
  // procedure body
  escreval( // argument comment
    "P")
  // procedure closing
fimprocedimento // procedure end
// function documentation
funcao F(): inteiro
inicio
  retorne 7
fimfuncao // function end
// global declarations
var // global header
  x: inteiro // variable comment
// main body
inicio
  P()
  x <- F()
  escreval(x)
fimalgoritmo
