algoritmo "call forms"
var
  n: inteiro
  r: real

procedimento show(a: inteiro; var b: real)
inicio
  b <- a
fimprocedimento

procedimento ping()
inicio
  retorne
fimprocedimento

funcao value(x: inteiro): real
inicio
  retorne x
fimfuncao
inicio
  show
  show(1, r)
  ping()
  value(n)
  value()
fimalgoritmo
