// Comments remain attached when this program is formatted.
algoritmo "Comentários"
var
  valor: inteiro // A zero-initialized value.
inicio
  se valor = 0 entao
    // Keep this explanation inside the branch.
    escreval("ação") // Decoded text is preserved.
  senao
    // Even an empty branch retains its comments.
  fimse
fimalgoritmo
