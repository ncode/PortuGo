algoritmo "comparison edges"
funcao N(idx: inteiro): inteiro
inicio
escreval(idx)
retorne idx
fimfuncao
funcao T(idx: inteiro): caractere
inicio
escreval(idx)
retorne "x"
fimfuncao
inicio
escreval((N(1)) = (T(2)))
escreval((N(1)) <> (T(2)))
escreval((N(1)) < (T(2)))
escreval((N(1)) > (T(2)))
escreval((N(1)) <= (T(2)))
escreval((N(1)) >= (T(2)))
fimalgoritmo
