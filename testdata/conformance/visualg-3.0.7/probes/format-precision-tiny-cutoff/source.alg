algoritmo "format cutoffs"
inicio
escreval("|",caracpnum("9e-18"):10:30,"|")
escreval("|",caracpnum("9.999999999999999e-18"):10:30,"|")
escreval("|",caracpnum("1e-17"):10:30,"|")
escreval("|",caracpnum("1.1e-17"):10:30,"|")
escreval("|",caracpnum("1.5e-17"):10:30,"|")
escreval("|",caracpnum("-9e-18"):10:30,"|")
escreval("|",caracpnum("-1e-17"):10:30,"|")
fimalgoritmo
