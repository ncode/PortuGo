algoritmo "precision limits"
inicio
escreval("|",caracpnum("1e-10"):10:60,"|")
escreval("|",caracpnum("1e-17"):10:60,"|")
escreval("|",caracpnum("1e-18"):10:60,"|")
escreval("|",caracpnum("1e-20"):10:60,"|")
escreval("|",caracpnum("1e-30"):10:60,"|")
escreval("|",caracpnum("1e-40"):10:60,"|")
fimalgoritmo
