algoritmo "decimal conversion"
inicio
escreval(numpcarac(caracpnum("0.000000000000000006e18")))
escreval("|",caracpnum("0.000000000000000006e18"):10:30,"|")
escreval(numpcarac(caracpnum("0.00000000000000006e18")))
escreval("|",caracpnum("0.00000000000000006e18"):10:30,"|")
escreval(numpcarac(caracpnum("000000000000000006e1")))
escreval("|",caracpnum("000000000000000006e1"):10:30,"|")
escreval(numpcarac(caracpnum("0000000000000000006e1")))
escreval("|",caracpnum("0000000000000000006e1"):10:30,"|")
escreval(numpcarac(caracpnum("6e-18")))
escreval("|",caracpnum("6e-18"):10:30,"|")
escreval(numpcarac(caracpnum("000000000000000006e-18")))
escreval("|",caracpnum("000000000000000006e-18"):10:30,"|")
fimalgoritmo
