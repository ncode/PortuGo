algoritmo "comparison"
inicio
escreval("Z" < "a")
escreval("a" < "aa")
escreval("10" < "2")
escreval("a" = "a ")
escreval("ä" < "z")
escreval("é" < "f")
escreval("æ" < "b")
escreval("ø" < "p")
escreval("œ" < "p")
escreval("€" < "A")
escreval("ß" = "SS")
escreval("Á" = "á")
fimalgoritmo
