algoritmo "decimal conversion"
inicio
escreval(numpcarac(caracpnum("0.00000000000000006")))
escreval("|",caracpnum("0.00000000000000006"):10:30,"|")
escreval(numpcarac(caracpnum("00.00000000000000006")))
escreval("|",caracpnum("00.00000000000000006"):10:30,"|")
escreval(numpcarac(caracpnum("000.00000000000000006")))
escreval("|",caracpnum("000.00000000000000006"):10:30,"|")
escreval(numpcarac(caracpnum("000000000000000006.0")))
escreval("|",caracpnum("000000000000000006.0"):10:30,"|")
escreval(numpcarac(caracpnum("0000000000000000006.0")))
escreval("|",caracpnum("0000000000000000006.0"):10:30,"|")
escreval(numpcarac(caracpnum("00000000000000000006.0")))
escreval("|",caracpnum("00000000000000000006.0"):10:30,"|")
fimalgoritmo
