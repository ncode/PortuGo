algoritmo "format value identity"
inicio
escreval(numpcarac(12.3456789012345))
escreval("|",12.3456789012345:10:30,"|")
escreval(numpcarac(90.1234567890123))
escreval("|",90.1234567890123:10:30,"|")
escreval(numpcarac(92.1234567890123))
escreval("|",92.1234567890123:10:30,"|")
escreval(numpcarac(98.1234567890123))
escreval("|",98.1234567890123:10:30,"|")
escreval(numpcarac(123.456789012345))
escreval("|",123.456789012345:10:30,"|")
escreval(numpcarac(923.456789012345))
escreval("|",923.456789012345:10:30,"|")
fimalgoritmo
