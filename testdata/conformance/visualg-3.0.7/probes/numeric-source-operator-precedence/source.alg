algoritmo "exponent token boundary"
inicio
escreval(numpcarac(10e-1))
escreval(numpcarac(2.5e-2))
escreval(numpcarac(2e-3^2))
escreval(numpcarac(2E + 3))
escreval(numpcarac(2e - 3))
escreval(numpcarac(1e2+3))
escreval(numpcarac(1e2-3))
escreval(numpcarac(1.e+2))
escreval(numpcarac(1.e-2))
fimalgoritmo
