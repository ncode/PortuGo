algoritmo "format value identity"
inicio
escreval(numpcarac(6/(10^18)))
escreval("|",6/(10^18):10:30,"|")
escreval(numpcarac(9/(10^18)))
escreval("|",9/(10^18):10:30,"|")
escreval(numpcarac(6*(2^(-60))))
escreval("|",6*(2^(-60)):10:30,"|")
escreval(numpcarac(9*(2^(-60))))
escreval("|",9*(2^(-60)):10:30,"|")
fimalgoritmo
