algoritmo "choice ranges"
funcao selected: inteiro
inicio
escreval("SELECTOR")
retorne 3
fimfuncao
funcao lower: inteiro
inicio
escreval("LOWER")
retorne 1
fimfuncao
funcao upper: inteiro
inicio
escreval("UPPER")
retorne 5
fimfuncao
inicio
escolha 0
caso lower() ate upper()
escreval("MATCH")
outrocaso
escreval("MISS")
fimescolha
escreval("DONE")
fimalgoritmo
