algoritmo "decimal conversion"
inicio
escreval(numpcarac(caracpnum("0.000000000000006")))
escreval("|",caracpnum("0.000000000000006"):10:30,"|")
escreval(numpcarac(caracpnum("0.0000000000000006")))
escreval("|",caracpnum("0.0000000000000006"):10:30,"|")
escreval(numpcarac(caracpnum("0.00000000000000006")))
escreval("|",caracpnum("0.00000000000000006"):10:30,"|")
escreval(numpcarac(caracpnum("0.000000000000000006")))
escreval("|",caracpnum("0.000000000000000006"):10:30,"|")
escreval(numpcarac(caracpnum("0.0000000000000000006")))
escreval("|",caracpnum("0.0000000000000000006"):10:30,"|")
escreval(numpcarac(caracpnum("0.00000000000000000006")))
escreval("|",caracpnum("0.00000000000000000006"):10:30,"|")
fimalgoritmo
