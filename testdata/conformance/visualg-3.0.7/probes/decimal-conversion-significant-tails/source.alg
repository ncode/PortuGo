algoritmo "decimal conversion"
inicio
escreval(numpcarac(caracpnum("1.23456789012345678901")))
escreval("|",caracpnum("1.23456789012345678901"):10:30,"|")
escreval(numpcarac(caracpnum("0.123456789012345678901")))
escreval("|",caracpnum("0.123456789012345678901"):10:30,"|")
escreval(numpcarac(caracpnum("123456789012345678.901")))
escreval("|",caracpnum("123456789012345678.901"):10:30,"|")
escreval(numpcarac(caracpnum("1234567890123456789.01")))
escreval("|",caracpnum("1234567890123456789.01"):10:30,"|")
escreval(numpcarac(caracpnum("12345678901234567890.1")))
escreval("|",caracpnum("12345678901234567890.1"):10:30,"|")
escreval(numpcarac(caracpnum("999999999999999999.99")))
escreval("|",caracpnum("999999999999999999.99"):10:30,"|")
fimalgoritmo
