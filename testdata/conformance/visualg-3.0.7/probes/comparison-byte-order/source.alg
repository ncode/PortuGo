algoritmo "comparison edges"
inicio
escreval("€" < "á")
escreval("Œ" < "Á")
escreval("Ÿ" < "ÿ")
escreval("œ" < "ø")
escreval(carac(129) < "A")
escreval(carac(128) < carac(129))
escreval(carac(156) < carac(155))
escreval("a" < "a ")
escreval("a " < "aa")
escreval("Á" < "á")
escreval("ß" = "SS")
fimalgoritmo
